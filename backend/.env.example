# Database connection (PostgreSQL with PostGIS extension)
# E.g. Supabase, Neon, or local Postgres. Use postgresql+asyncpg:// for async SQLAlchemy
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ulavu

# Exotel Telephony & SMS credentials
# Account SID (or Subdomain account name), API Key, and API Token from Exotel Dashboard -> API Settings
EXOTEL_ACCOUNT_SID=your_exotel_account_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_PHONE_NUMBER=your_exotel_virtual_phone_number

# Test / Demo Retailer Phone for notifications
DEMO_RETAILER_SMS_PHONE=+919876543210
TEST_RETAILER_PHONE=+919876543210

# Server settings
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
